{
  "name": "dsh-tool-lamber",
  "version": "0.1.0",
  "private": true,
  "description": "deepseek-harness plugin exposing lamber business capabilities as agent tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node ../scripts/build-contract.mjs && tsc",
    "typecheck": "node ../scripts/build-contract.mjs && tsc --noEmit",
    "test:scope": "npm run build && node ../scripts/test-project-scope.mjs",
    "test:contract": "npm run build && node ../scripts/test-contract.mjs",
    "test:template-read": "npm run build && node ../scripts/test-template-read.mjs",
    "test:template-catalog": "npm run build && node ../scripts/test-template-catalog.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
